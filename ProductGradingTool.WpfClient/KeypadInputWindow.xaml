<Window x:Class="ProductGradingTool.WpfClient.KeypadInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductGradingTool.WpfClient"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Keypad Input"
        Width="250"
        Height="416"
        FocusManager.FocusedElement="{Binding ElementName=InputTextBox}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Padding" Value="15,5"/>
        </Style>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Height="400" Width="250">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox x:Name="InputGroupBox" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Header="Product ID">
                <TextBox x:Name="InputTextBox" FontFamily="Consolas" FontSize="34" TextAlignment="Right"></TextBox>
            </GroupBox>
            <Button Grid.Row="1" Grid.Column="0" Click="OnNumericInput">7</Button>
            <Button Grid.Row="1" Grid.Column="1" Click="OnNumericInput">8</Button>
            <Button Grid.Row="1" Grid.Column="2" Click="OnNumericInput">9</Button>
            <Button Grid.Row="2" Grid.Column="0" Click="OnNumericInput">4</Button>
            <Button Grid.Row="2" Grid.Column="1" Click="OnNumericInput">5</Button>
            <Button Grid.Row="2" Grid.Column="2" Click="OnNumericInput">6</Button>
            <Button Grid.Row="3" Grid.Column="0" Click="OnNumericInput">1</Button>
            <Button Grid.Row="3" Grid.Column="1" Click="OnNumericInput">2</Button>
            <Button Grid.Row="3" Grid.Column="2" Click="OnNumericInput">3</Button>
            <Button Grid.Row="3" Grid.Column="2" Click="OnNumericInput">3</Button>
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Click="OnNumericInput">0</Button>
            <Button Grid.Row="4" Grid.Column="2" Click="OnNumericInput" IsEnabled="False">.</Button>
            <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Background="OrangeRed" FontWeight="SemiBold" IsCancel="True" Click="OnCancel">Cancel</Button>
                <Button Grid.Column="1" Background="LightGreen" FontWeight="SemiBold" IsDefault="True" Click="OnSubmit" Content="Accept"></Button>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
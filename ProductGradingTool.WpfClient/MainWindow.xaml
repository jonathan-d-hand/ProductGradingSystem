<Window x:Class="ProductGradingTool.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProductGradingTool.WpfClient"
        mc:Ignorable="d"
        Title="Product Grading Tool" Height="516" Width="800"
        Loaded="OnWindowLoaded">
    <Viewbox Stretch="Uniform">
        <DockPanel x:Name="MainPanel" Width="800" Height="500">
            <!-- Top Panel: General Info -->
            <Border DockPanel.Dock="Top" Padding="1">
                <Grid>
                    <Label HorizontalAlignment="Left" Content="{Binding UserId}" ContentStringFormat="User ID: {0}"></Label>
                    <Label HorizontalAlignment="Center">Terminal Name</Label>
                    <Label HorizontalAlignment="Right">Grouping System</Label>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Bottom" Padding="3">
                <local:CommandPanel />
            </Border>

            <!-- Middle Panel: Main Panel -->
            <DockPanel>
                <Border DockPanel.Dock="Right">
                    <Grid Width="200">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" HorizontalAlignment="Right" FontWeight="Bold">
                            <TextBlock Text="{ Binding Product.CurrentState }" />
                        </Label>
                    
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right">Product ID:</Label>
                            <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Content="{ Binding Product.ProductId }"></Label>

                            <Label Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right">Weight:</Label>
                            <Label Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Content="{ Binding Product.Weight }"></Label>

                            <Label Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right">Fat Value:</Label>
                            <Label Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Content="{ Binding Product.FatValue }"></Label>

                            <Label Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right">Lean Value:</Label>
                            <Label Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Content="{ Binding Product.LeanValue }"></Label>

                            <Label Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right">Grade:</Label>
                            <Label Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Content="{ Binding Product.Grade }"></Label>
                        </Grid>

                        <Label Grid.Row="2" HorizontalAlignment="Right" FontWeight="Bold">History</Label>

                        <DataGrid Grid.Row="3" ItemsSource="{ Binding ProductHistory }" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" IsReadOnly="True" Width="Auto" Binding="{ Binding TimeStamp, StringFormat={}{0:HH:mm:ss} }" />
                                <DataGridTextColumn Header="Product ID" IsReadOnly="True" Width="*" Binding="{ Binding ProductId }" />
                                <DataGridTemplateColumn Header="" IsReadOnly="True" Width="Auto" /><!--todo: sync feature-->
                            </DataGrid.Columns>
                        </DataGrid>
                    
                    </Grid>
                </Border>
                <Border> <!-- Main scan interface -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <local:WeightCapturePanel IsEnabled="{ Binding Product.IsEditable }" />
                    </StackPanel>
                </Border>
            </DockPanel>
        
        </DockPanel>
    </Viewbox>
</Window>

<UserControl x:Class="ProductGradingTool.WpfClient.CommandPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductGradingTool.WpfClient"
             mc:Ignorable="d">
    <Grid>
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="16"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Padding="20,5" Margin="5,5" HorizontalAlignment="Left" Background="DarkRed" Foreground="Yellow" Command="{ Binding Command.MarkContaminatedCommand }">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Mark<LineBreak/>Contaminated</TextBlock>
            </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="20,5" Margin="5,5" Background="White" Command="{ Binding Command.SuspendCommand }">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Lock<LineBreak/>Screen</TextBlock>
            </Button>
            <Button Padding="20,5" Margin="5,5" Background="LightBlue" Command="{ Binding Command.ChangeUserCommand }">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Change<LineBreak/>User</TextBlock>
            </Button>
            <Button Padding="20,5" Margin="5,5" Background="LightBlue" Command="{ Binding Command.ManualInputCommand }">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Manual<LineBreak/>Input</TextBlock>
            </Button>
            <Button Padding="20,5" Margin="5,5" Background="LightBlue" Command="{ Binding Command.ResetCommand }">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Reset<LineBreak/>Terminal</TextBlock>
            </Button>
            <Button Padding="20,5" Margin="5,5" Background="LightGreen" Command="{ Binding Command.SubmitCommand }">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Submit<LineBreak/>Scan</TextBlock>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="ProductGradingTool.WpfClient.WeightCapturePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProductGradingTool.WpfClient"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold"></Setter>
        </Style>
    </UserControl.Resources>
    <Border Padding="4" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0">Weight</Label>
            <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True" Text="{ Binding WeightCapture.Weight, Mode=OneWay }"></TextBox>

            <Button Grid.Row="1" Grid.Column="1" Command="{ Binding WeightCapture.CaptureCommand }">Capture</Button>
            <Button Grid.Row="2" Grid.Column="1" Command="{ Binding WeightCapture.InputCommand }">Input</Button>
            <Button Grid.Row="3" Grid.Column="1" Command="{ Binding WeightCapture.ResetCommand }">Reset</Button>

        </Grid>
    </Border>
</UserControl>
